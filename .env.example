# All settings are read from environment variables; the values below are the defaults.
# Set to "false" to call the real local Ollama / commercial LLM endpoints.
MOCK_LLM_RESPONSES=true

# Local LLM (Ollama on the local workstation)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5-coder:14b

# Commercial cloud LLM (any OpenAI-compatible endpoint)
COMMERCIAL_LLM_BASE_URL=https://api.openai.com/v1
COMMERCIAL_LLM_MODEL=gpt-4o-mini
COMMERCIAL_LLM_API_KEY=

# Shared secret for AES-256-CBC response encryption (needed only for encrypt_response=true).
# Use a long random string and never commit the real value.
AES_SHARED_SECRET=
